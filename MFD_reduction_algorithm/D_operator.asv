function out = D_operator(Ms, f, t, s)
% Applies the polynomial operator Ms(s) by substituting s → D (d/dt)
% This transforms frequency-domain polynomials into time-domain differential operators
%
% Inputs:
%   Ms: symbolic m×n matrix containing polynomials in the Laplace variable s
%   f : symbolic n×1 vector of time-domain functions
%   t : symbolic variable representing time
%   s : symbolic variable representing the Laplace variable
%
% Output:
%   out: symbolic m×1 vector where each element is the result of applying
%        the corresponding row of Ms (as a differential operator) to f
%

    Ms = sym(Ms);
    f = sym(f);
    
    [m,n] = size(Ms);
    
    % Reshape f to ensure it's a column vector, even if user passed a row vector
    % This prevents dimension mismatch errors in the multiplication logic
    f = reshape(f, [n,1]);
    
    % Preallocate output vector for efficiency
    % Each element will contain one differential equation result
    out = sym(zeros(m,1));
    
    % Process each row of the matrix Ms
    % Each row represents one output equation in the system
    for i = 1:m
        % Initialize accumulator for the i-th output component
        % We'll build up the result term by term
        acc = sym(0);
        
        % Process each column, which corresponds to one input function
        % This implements the matrix-vector multiplication Ms * f
        for j = 1:n
            % Extract the (i,j) element and expand it to standard polynomial form
            % Expanding ensures the polynomial is in a canonical form for processing
            Mij = expand(Ms(i,j));
            
            % Decompose the polynomial into coefficients and monomial terms
            % For example, 3s² + 2s + 1 becomes:
            %   c = [3, 2, 1] and terms = [s², s, 1]
            [c, terms] = coeffs(Mij, s);
            
            % Initialize accumulator for this particular matrix element's contribution
            term = sym(0);
            
            % Process each monomial term in the polynomial
            for k = 1:numel(c)
                % Determine the degree (power) of s in this term
                % The degree tells us what order derivative to take
                degk = feval(symengine, 'degree', terms(k), s);
                
                % Check if this is a constant term (degree 0 or -infinity)
                % -inf occurs when the term doesn't contain s at all
                if isequal(degk, sym(-inf)) || double(degk) == 0
                    % Constant term: just multiply the coefficient by the function
                    % No differentiation needed since s⁰ → D⁰ = identity operator
                    term = term + c(k) * f(j);
                else
                    % Non-constant term: apply the differential operator
                    % c(k)*s^degk becomes c(k)*d^degk/dt^degk
                    % This is the heart of the s → D substitution
                    term = term + c(k) * diff(f(j), t, double(degk));
                end
            end
            
            % Add this matrix element's contribution to the accumulator
            % This completes the processing of Ms(i,j) * f(j)
            acc = acc + term;
        end
        
        % Store the simplified result for the i-th output equation
        % Simplification helps reduce algebraic complexity and makes results more readable
        out(i) = simplify(acc);
    end
end